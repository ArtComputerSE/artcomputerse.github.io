---
layout: base.njk
section: courses
---
<div class="page-top"><a class="back-link" href="/#kurser">← Alla kurser</a><p class="eyebrow">{{ category }}</p><h1>{{ title }}</h1></div>
<div class="detail-grid">
  <article class="prose">{{ content | safe }}
    {% set descriptionPdfUrl = page.inputPath | courseDescriptionPdf %}
    {% if descriptionPdfUrl %}<p><a class="text-link" href="{{ descriptionPdfUrl }}" download>Ladda ner kursbeskrivning (PDF) <span aria-hidden="true">↓</span></a></p>{% endif %}
  </article>
  <aside class="course-contact"><p class="eyebrow">Kontakt</p><h2>Frågor om kursen?</h2><p>Kontakta Per Lundholm om du vill veta mer.</p><a class="text-link" href="/kontakt/">Kontaktuppgifter <span aria-hidden="true">→</span></a></aside>
</div>
